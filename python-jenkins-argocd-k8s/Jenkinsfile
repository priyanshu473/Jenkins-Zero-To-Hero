pipeline {
    agent any

    environment {
        IMAGE = "priyanshu18roy/django-todo:${BUILD_NUMBER}"
        APP_SERVER = "172.31.12.65"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker image') {
            steps {
                sh '''
                    docker build \
                      -t "$IMAGE" \
                      -f python-jenkins-argocd-k8s/Dockerfile \
                      python-jenkins-argocd-k8s
                '''
            }
        }

        stage('Push image to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login --username "$DOCKERHUB_USER" --password-stdin
                        docker push "$IMAGE"
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to app server') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'app-server-ssh',
                    keyFileVariable: 'SSH_KEY',
                    usernameVariable: 'SSH_USER'
                )]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                          -o StrictHostKeyChecking=accept-new \
                          "$SSH_USER@$APP_SERVER" \
                          "docker pull '$IMAGE' &&
                           (docker rm -f django-todo >/dev/null 2>&1 || true) &&
                           docker run -d --name django-todo --restart unless-stopped -p 8000:8000 '$IMAGE'"
                    '''
                }
            }
        }
    }
}
